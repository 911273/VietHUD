# VietHUD pipeline configuration. Copy to `.env` (chmod 600) and fill in.
# vhpaths.py loads this; real environment variables take precedence.

# --- GitHub push target ---
VIETHUD_GIT_REMOTE=https://github.com/911273/VietHUD.git
VIETHUD_GIT_BRANCH=main
VIETHUD_GIT_SPEEDMAP_SUBDIR=speedmap
# Fine-grained Personal Access Token with "Contents: Read and write" on the repo.
# Leave empty if you use an SSH deploy key instead (then set VIETHUD_GIT_REMOTE to
# the git@github.com:911273/VietHUD.git form).
GITHUB_TOKEN=
GIT_AUTHOR_NAME=VietHUD Pipeline
GIT_AUTHOR_EMAIL=pipeline@viethud.local

# --- Telegram notification (reuse your existing bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Data build options ---
VIETHUD_REGION=VN
# OTA manifest URL shown in the Telegram message (must match your raw GitHub path)
VIETHUD_RAW_MANIFEST_URL=https://raw.githubusercontent.com/911273/VietHUD/main/speedmap/manifest.txt
# Directory of Vietnamese MP3 voice prompts to pack into speedmap/sounds/
# (must contain chuydentinhieugiaothong.mp3, speedcamera.mp3, batdaukhudancu.mp3, ...).
VIETHUD_SOUNDS_SRC=/opt/viethud-pipeline/assets/sounds
# pyosmium node-location index. flex_mem is fastest if RAM allows; on a low-RAM
# Pi use a file-backed index instead, e.g.:
#   VIETHUD_OSM_INDEX=sparse_file_array,/opt/viethud-pipeline/data/osm/nodes.idx
VIETHUD_OSM_INDEX=flex_mem

# Optional: override the pipeline root (defaults to the install dir).
# VIETHUD_PIPELINE_HOME=/opt/viethud-pipeline

# Signing key for manifest.txt.sig (ECDSA P-256). NEVER commit. Copy the PC key
# (~/.viethud/manifest_signing_key.pem) here, chmod 600.
VIETHUD_SIGNING_KEY=/opt/viethud-pipeline/secrets/manifest_signing_key.pem
